<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bevy.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Test behaviors are documented inline; XML docs are not required here. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- The input tests write the native snapshot struct directly, which has fixed buffers. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../BevyCSharp/BevyCSharp.csproj"/>
        <ProjectReference Include="../BevyCSharp.Generator/BevyCSharp.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>


    <!--
      Test assets, copied beside the test binary because the asset server resolves paths relative
      to an `assets` directory next to the executable.
    -->
    <ItemGroup>
        <None Include="assets/**" CopyToOutputDirectory="PreserveNewest" LinkBase="assets"/>
    </ItemGroup>

</Project>
