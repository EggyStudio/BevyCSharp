<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bevy.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Test behaviors are documented inline; XML docs are not required here. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- The input tests write the native snapshot struct directly, which has fixed buffers. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"/>
        <!--
          A test the bridge or the machine cannot run reports itself skipped rather than passing by
          returning early, which xunit 2 has no way of its own to say once a test has started.
        -->
        <PackageReference Include="Xunit.SkippableFact" Version="1.5.85"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../BevyCSharp/BevyCSharp.csproj"/>

        <!--
          The editor, for the tables under it: what is on the menu, what an entity looks like in a
          list, what a settings page holds. All three are ordinary data structures with ordinary
          answers, and none of them needs a window to be asked. Referencing it also compiles the
          editor wherever the tests are built, which is the only place that happened at all.
        -->
        <ProjectReference Include="../BevyCSharp.Editor/BevyCSharp.Editor.csproj"/>
        <ProjectReference Include="../BevyCSharp.Generator/BevyCSharp.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>


    <!--
      Test assets, copied beside the test binary under the directory the harness points Bevy at.

      The destination is spelled out rather than left to LinkBase, which not every build host
      applies the same way: some flatten the tree into the output root, leaving the subdirectories
      empty and every asset load failing on a path that looks correct.
    -->
    <ItemGroup>
        <None Include="assets/**" CopyToOutputDirectory="PreserveNewest"
              Link="assets/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <!--
      Files compiled into the test assembly under assets/, as an export that embeds a game's asset
      files does, for the tests that read through AssetFiles with no file on disk.
    -->
    <ItemGroup>
        <EmbeddedResource Include="embedded/**" LogicalName="assets/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false"/>
    </ItemGroup>

</Project>
