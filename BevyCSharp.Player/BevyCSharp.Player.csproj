<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>BevyCSharp.Player</RootNamespace>
    </PropertyGroup>

    <!--
      Plays a scene file, as the editor's Play tab asks: the library, the script host that compiles
      the asset folder's scripts, and the generator for this project's own startup behavior.
    -->
    <ItemGroup>
        <ProjectReference Include="../BevyCSharp/BevyCSharp.csproj"/>
        <ProjectReference Include="../BevyCSharp.Scripting/BevyCSharp.Scripting.csproj"/>
        <ProjectReference Include="../BevyCSharp.Generator/BevyCSharp.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
