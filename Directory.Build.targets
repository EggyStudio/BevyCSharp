<Project>

    <!--
      The projects here reference the library as a project rather than as the package, so the
      package's build files are not imported for them. This brings in the one that matters to an
      export, which embeds a game's asset files in its assembly when asked and does nothing
      otherwise.
    -->
    <Import Project="$(MSBuildThisFileDirectory)BevyCSharp/build/BevyCSharp.Embed.targets"/>

    <!--
      The library keeps its reference to the modules to itself, so the package carries their
      assemblies in its lib folder rather than naming them as packages it depends on, and a project
      here that references the library references the modules beside it, so its build lists them
      among the assemblies it loads, as a game on the package has them from the lib folder.
    -->
    <ItemGroup Condition="'$(MSBuildProjectName)' != 'BevyCSharp'">
        <_BevyCSharpReference Include="@(ProjectReference->WithMetadataValue('Filename', 'BevyCSharp'))"/>
        <_LevelsReference Include="@(ProjectReference->WithMetadataValue('Filename', 'Levels'))"/>
        <ProjectReference Include="$(MSBuildThisFileDirectory)modules/Levels/Levels/Levels.csproj"
                          Condition="'@(_BevyCSharpReference)' != '' And '@(_LevelsReference)' == ''"/>
    </ItemGroup>

</Project>
