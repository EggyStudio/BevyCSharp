<Project>

    <!--
      Compiles the game's asset folder into its assembly, every file named under assets/, where
      AssetFiles finds the ones the managed side reads (scenes, data assets, material and mesh files
      and the id sidecars beside them) and the bridge's default asset source finds the rest through
      it, when no file on disk answers first. Off unless BevyCSharpEmbedAssets is true, which the
      editor's export passes when it embeds, so the game ships with no asset folder beyond its
      scripts and shaders, and with the bridge every game shares.

      Scripts and shaders are left out, since the game compiles them from files as it runs, slangc
      being a process that is handed a path and finds imports beside it, and so is a folder whose
      name starts with a dot, such as the shader compiler's cache, which is a tool's.
      Named by hand rather than by MSBuild's own resource naming, which turns folders into dots and
      cannot be told apart from a dot in a file name.
    -->

    <ItemGroup Condition="'$(BevyCSharpEmbedAssets)' == 'true' And Exists('$(MSBuildProjectDirectory)/assets')">
        <EmbeddedResource Include="$(MSBuildProjectDirectory)/assets/**/*"
                          Exclude="$(MSBuildProjectDirectory)/assets/**/.*/**;$(MSBuildProjectDirectory)/assets/**/*.cs;$(MSBuildProjectDirectory)/assets/**/*.slang"
                          LogicalName="assets/%(RecursiveDir)%(Filename)%(Extension)"
                          WithCulture="false"/>
    </ItemGroup>

</Project>
