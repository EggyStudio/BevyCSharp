<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>BevyCSharp's rendering, Render and Shaders, cameras, lights, materials, meshes, the look and the Slang programs.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Native/BevyCSharp.Native.csproj"/>
        <ProjectReference Include="../Core/BevyCSharp.Core.csproj"/>
        <ProjectReference Include="../Assets/BevyCSharp.Assets.csproj"/>
    </ItemGroup>

    <!--
      The Sky module both engines share, a git submodule under modules/, kept out of what
      a project referencing this one sees, since the module is not a package of its own. The
      flat project's package carries its assembly in its lib folder beside the areas'.
    -->
    <ItemGroup>
        <ProjectReference Include="../../modules/Sky/Sky/Sky.csproj" PrivateAssets="all"/>
    </ItemGroup>

    <!-- The area's own programs, read as Slang source when each is first built, so the area
         carries them as it carries everything else it runs. -->
    <ItemGroup>
        <EmbeddedResource Include="Kernels/*.slang" LogicalName="Bevy.Kernels.%(Filename)%(Extension)"/>
    </ItemGroup>















    <!--
      The projects above this one that reach its internals, each under what it reaches, and each
      on build/norm/1.6.txt with why, which N 1.6 holds them to.
    -->
    <ItemGroup>
        <!-- RenderWork -->
        <InternalsVisibleTo Include="BevyCSharp"/>
        <!-- Render.NoRenderer -->
        <InternalsVisibleTo Include="BevyCSharp.Animation"/>
        <!-- Looks, Recorder -->
        <InternalsVisibleTo Include="BevyCSharp.Diagnostics"/>
        <!-- PngWriter, SamplerSettings.ClampedTable, Shaders.KernelDraw, Shaders.KernelProgram, Shaders.SampledTexturesPerStage, Shaders.SetEnginePrepass, Shaders.SetEngineViewDispatches, Shaders.SetEngineViewDraws, Shaders.SetEngineViewImages -->
        <InternalsVisibleTo Include="BevyCSharp.GlobalIllumination"/>
        <!-- PngWriter, Render.CreateMesh -->
        <InternalsVisibleTo Include="BevyCSharp.Levels"/>
        <!-- Images.GridPixels -->
        <InternalsVisibleTo Include="BevyCSharp.Modeling"/>
        <!-- Render.Attach, Render.NoRenderer -->
        <InternalsVisibleTo Include="BevyCSharp.Render2d"/>
        <!-- MaterialJson, MeshJson -->
        <InternalsVisibleTo Include="BevyCSharp.Scenes"/>
        <!-- SamplerSettings.ClampedTable, SamplerSettings.LinearTable, Shaders.KernelDraw, Shaders.KernelProgram, Shaders.SetEnginePrepass, Shaders.SetEngineViewDispatches, Shaders.SetEngineViewDraws, Shaders.SetEngineViewImages -->
        <InternalsVisibleTo Include="BevyCSharp.Sky"/>
        <!-- Render.Attach, Render.NoRenderer -->
        <InternalsVisibleTo Include="BevyCSharp.Ui"/>
        <!-- Render.CreateBarkMaterial, Render.CreateImageLevels, Render.CreateImpostorMaterial, Render.CreateLeafMaterial, Render.CreateMesh, Render.MipChain, Render.SetFieldTint, Render.SetTreeWind -->
        <InternalsVisibleTo Include="BevyCSharp.Vegetation"/>
        <!-- AnimationReader, GifWriter, PngWriter, RgbaFrame -->
        <InternalsVisibleTo Include="bcs"/>
    </ItemGroup>

</Project>
