<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>BevyCSharp's levels, LevelSpawner, which builds a level's meshes, collision and entities into a scene.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Core/BevyCSharp.Core.csproj"/>
        <ProjectReference Include="../Rendering/BevyCSharp.Rendering.csproj"/>
        <ProjectReference Include="../Physics/BevyCSharp.Physics.csproj"/>
        <ProjectReference Include="../Modeling/BevyCSharp.Modeling.csproj"/>
        <ProjectReference Include="../Vegetation/BevyCSharp.Vegetation.csproj"/>
    </ItemGroup>

    <!--
      The Levels module both engines share, a git submodule under modules/, whose assembly this
      package carries in its lib folder with its documentation, since a package cannot name a
      project as a dependency and the modules are not packages of their own. It is the lowest
      package naming the module, and those above it that name it too find it here.
    -->
    <ItemGroup>
        <ProjectReference Include="../../modules/Levels/Levels/Levels.csproj" PrivateAssets="all"/>
    </ItemGroup>
    <PropertyGroup>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BevyCSharpPackModule</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>
    <Target Name="BevyCSharpPackModule" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <_BevyCSharpModule Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'Levels'"/>
            <BuildOutputInPackage Include="@(_BevyCSharpModule)"/>
            <BuildOutputInPackage Include="@(_BevyCSharpModule->'%(RootDir)%(Directory)%(Filename).xml')"
                                  Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')"/>
        </ItemGroup>
    </Target>

</Project>
