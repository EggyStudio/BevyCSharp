<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>BevyCSharp's levels, LevelSpawner, which builds a level's meshes, collision and entities into a scene.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Core/BevyCSharp.Core.csproj"/>
        <ProjectReference Include="../Rendering/BevyCSharp.Rendering.csproj"/>
        <ProjectReference Include="../Physics/BevyCSharp.Physics.csproj"/>
        <ProjectReference Include="../Modeling/BevyCSharp.Modeling.csproj"/>
        <ProjectReference Include="../Vegetation/BevyCSharp.Vegetation.csproj"/>
    </ItemGroup>

    <!--
      The Levels module both engines share, a git submodule under modules/, kept out of what
      a project referencing this one sees, since the module is not a package of its own. The
      flat project's package carries its assembly in its lib folder beside the areas'.
    -->
    <ItemGroup>
        <ProjectReference Include="../../modules/Levels/Levels/Levels.csproj" PrivateAssets="all"/>
    </ItemGroup>

</Project>
