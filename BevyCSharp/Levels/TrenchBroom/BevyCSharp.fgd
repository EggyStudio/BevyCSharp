// The entity classes a BevyCSharp level knows, for TrenchBroom. A class the engine registers is
// built as it says, and any other stands as its place and its keys for a game to read.

@SolidClass = worldspawn : "The level's own brushes"
[
	_units_per_meter(float) : "Units a meter" : 32 : "How many units make a meter, 32 when none is given"
]

@PointClass size(-16 -16 0, 16 16 72) color(0 255 0) = info_player_start : "Where the player starts, its arrow the way the player faces, read by the game"
[
	angle(integer) : "Yaw" : 0 : "The way the player faces, in degrees about the vertical"
]

@PointClass size(-16 -16 0, 16 16 96) color(80 160 60) = tree : "A tree grown from a species and a seed"
[
	species(string) : "Species" : "black-tupelo" : "A registered species, quaking-aspen, black-tupelo, weeping-willow, california-black-oak, bush, fern or one a game registers"
	seed(integer) : "Seed" : 0 : "The seed, which picks its variant and turns and sizes it"
]
