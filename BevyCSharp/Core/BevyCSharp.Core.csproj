        <!-- App.AreasWork, App.Running, ClockHoldNames, ClockHolds, ComponentField.ItemType, ComponentField.ReflectPath, ConsoleHost.Find, ConsoleHost.FirstAndRest, ConsoleHost.GiveUpAt, ConsoleHost.LaterFrom, ConsoleHost.LaterStill, ConsoleHost.Missing, EcsWorld.DescribeReflected, EngineSteps, MemoryGuard.PeakBytes, NativeCore, ReflectedLayouts, ReflectedSchemas, StateRegistry.Claimed, SystemTimes, Time.ClockFrames, Time.Holds -->
        <InternalsVisibleTo Include="BevyCSharp.Diagnostics"/>
