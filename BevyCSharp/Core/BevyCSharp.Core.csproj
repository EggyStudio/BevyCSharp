<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>BevyCSharp's core, the App and its World, the ECS over Bevy's, the vectors and transforms, the clocks, input and the runner of [Behavior] structs, with Bevy's reflected components.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Native/BevyCSharp.Native.csproj"/>
    </ItemGroup>

    <!--
      The description of Bevy's reflected components, written by the schema.dump command and
      checked in. The generator turns it into the typed wrappers in Bevy.Reflected. It is named here
      and nowhere else, so only Core is compiled with the wrappers and a game's own compilation
      emits nothing for it. The list of the components that moved beside it gives a reflected
      component the paths a scene written before the move names, and the names of the projects
      above Core that its wrappers keep apart from.
    -->
    <ItemGroup>
        <AdditionalFiles Include="Generated/bevy-components.tsv"/>
        <AdditionalFiles Include="Generated/bevy-former-paths.tsv"/>
        <AdditionalFiles Include="Generated/bevy-taken-names.txt"/>
    </ItemGroup>



















    <!--
      The projects above this one that reach its internals, each under what it reaches, and each
      on build/norm/1.6.txt with why, which N 1.6 holds them to.
    -->
    <ItemGroup>
        <!-- App.AreasWork, AssetHandle.Key, ComponentRegistry, ConsoleHost.Find, ConsoleHost.FirstAndRest, ConsoleHost.Missing, EngineLog, EngineSteps, NativeCore, ObserverRegistry, new AssetHandle -->
        <InternalsVisibleTo Include="BevyCSharp.Animation"/>
