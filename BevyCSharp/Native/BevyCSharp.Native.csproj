<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>BevyCSharp's native bridge, Bevy built for each platform the package runs on, with the entry points of the app and the frame, the loader that finds the library and the check of its ABI.</Description>
    </PropertyGroup>

    <!--
      Native runtime assets, staged per RID by build/build-native.sh. A missing slot is skipped
      rather than failing the build, so you can pack on one platform without cross-compiling for
      all the others.
    -->
    <ItemGroup>
        <None Include="$(BevyCSharpArtifactDir)linux-x64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)linux-x64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpArtifactDir)linux-arm64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)linux-arm64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpArtifactDir)linux-musl-x64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-musl-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)linux-musl-x64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpArtifactDir)linux-musl-arm64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-musl-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)linux-musl-arm64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpArtifactDir)win-x64/bevy_csharp.dll"
              Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)win-x64/bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpArtifactDir)win-arm64/bevy_csharp.dll"
              Pack="true" PackagePath="runtimes/win-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)win-arm64/bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpArtifactDir)osx-x64/libbevy_csharp.dylib"
              Pack="true" PackagePath="runtimes/osx-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)osx-x64/libbevy_csharp.dylib')"/>
        <None Include="$(BevyCSharpArtifactDir)osx-arm64/libbevy_csharp.dylib"
              Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)osx-arm64/libbevy_csharp.dylib')"/>
    </ItemGroup>

    <!--
      Repo-local development: copy whatever the last cargo build produced next to the sample and
      test binaries, so running them works without packing first, each project referencing this one
      copying it on.
    -->
    <ItemGroup>
        <None Include="$(BevyCSharpNativeOutDir)libbevy_csharp.so"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpNativeOutDir)libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpNativeOutDir)bevy_csharp.dll"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpNativeOutDir)bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpNativeOutDir)libbevy_csharp.dylib"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpNativeOutDir)libbevy_csharp.dylib')"/>
    </ItemGroup>

    <!--
      Where no build ran here and a bridge was put in this machine's slot of the staged ones alone,
      the slot is copied in the flat copy's place. The pack workflow's jobs that run a program from
      this repository download the bridge its native job built into that slot, as the pack reads it,
      and the storm job's tests of 292eead2 found no bridge beside them, since the copy above takes
      build/target alone and the slot was never read. The slot is named by the SDK's portable runtime
      identifier, linux-x64 where a distribution's SDK names its own, which is how build-native.sh
      names it.
    -->
    <PropertyGroup>
        <BevyCSharpHostArtifactDir>$(BevyCSharpArtifactDir)$(NETCoreSdkPortableRuntimeIdentifier)/</BevyCSharpHostArtifactDir>
        <BevyCSharpNoFlatCopy Condition="!Exists('$(BevyCSharpNativeOutDir)libbevy_csharp.so') And !Exists('$(BevyCSharpNativeOutDir)bevy_csharp.dll') And !Exists('$(BevyCSharpNativeOutDir)libbevy_csharp.dylib')">true</BevyCSharpNoFlatCopy>
    </PropertyGroup>
    <ItemGroup Condition="'$(BevyCSharpNoFlatCopy)' == 'true'">
        <None Include="$(BevyCSharpHostArtifactDir)libbevy_csharp.so"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpHostArtifactDir)libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpHostArtifactDir)bevy_csharp.dll"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpHostArtifactDir)bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpHostArtifactDir)libbevy_csharp.dylib"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpHostArtifactDir)libbevy_csharp.dylib')"/>
    </ItemGroup>

    <!--
      The native bridge is built by cargo, not by MSBuild, so nothing forces it to be current, and a
      stale one is a nasty failure to diagnose. Its ABI version still matches, but an entry point
      added since it was built is missing, and the app dies on the first call to it with an
      EntryPointNotFoundException far from the cause. A shader changed since, which the bridge
      carries in itself, says nothing at all, and the app draws the shaders of the bridge's build
      under the C# of the checkout.

      Its inputs are every file under native the library is built from, the shaders and its other
      carried files beside the Rust, the two manifests, the lock and the build script. The test
      modules and their fixtures are left out, since cargo builds them into the crate's tests alone
      and a change to one leaves the library as it was.

      Inputs and Outputs give each check below without a comparison of its own. MSBuild skips a
      target whose outputs are all newer than its inputs, so its body runs only when the bridge is
      stale. Both build scripts give each copy they stage the time of their run, so a run whose cargo
      had nothing to do, a file changed that only another profile builds, answers the checks too.

      Set BevyCSharpSkipNativeFreshnessCheck=true where timestamps carry no meaning, such as CI
      collecting binaries that were built from this very commit on other machines.
    -->
    <ItemGroup>
        <BevyCSharpNativeSource Include="$(BevyCSharpNativeDir)bevy_csharp/src/**/*"
                                Exclude="$(BevyCSharpNativeDir)bevy_csharp/src/**/tests.rs;$(BevyCSharpNativeDir)bevy_csharp/src/**/fixtures/**"/>
        <BevyCSharpNativeSource Include="$(BevyCSharpNativeDir)bevy_csharp/Cargo.toml;$(BevyCSharpNativeDir)bevy_csharp/build.rs"/>
        <BevyCSharpNativeSource Include="$(BevyCSharpNativeDir)Cargo.toml;$(BevyCSharpNativeDir)Cargo.lock"/>
        <BevyCSharpStagedNative Include="$(BevyCSharpArtifactDir)**/libbevy_csharp.so"/>
        <BevyCSharpStagedNative Include="$(BevyCSharpArtifactDir)**/bevy_csharp.dll"/>
        <BevyCSharpStagedNative Include="$(BevyCSharpArtifactDir)**/libbevy_csharp.dylib"/>
    </ItemGroup>
    <Target Name="BevyCSharpVerifyNativeIsCurrent"
            BeforeTargets="GenerateNuspec"
            Condition="'$(BevyCSharpSkipNativeFreshnessCheck)' != 'true'"
            Inputs="@(BevyCSharpNativeSource)"
            Outputs="@(BevyCSharpStagedNative)">

        <Warning Condition="'@(BevyCSharpStagedNative)' == ''"
                 Code="BCS100"
                 Text="No native bridge has been staged in $(BevyCSharpArtifactDir), so this package will carry no runtime assets and will not run. Run build/build-native.sh before packing."/>

        <Error Condition="'@(BevyCSharpStagedNative)' != ''"
               Code="BCS101"
               Text="The staged native bridge in $(BevyCSharpArtifactDir) is older than the files in $(BevyCSharpNativeDir) it is built from, its shaders among them. Re-run build/build-native.sh before packing, or the package will ship a bridge missing the newest entry points and drawing with the shaders it was built with."/>
    </Target>

    <!--
      A build checks the bridge it copies beside each project's binaries, the flat one the build
      scripts leave in build/target/release for running from a clone, where the check above runs at
      packing alone. A pull that changed a shader or an entry point then says so at dotnet build and
      dotnet run, where it drew the bridge's old shaders under the new C# with no word. It warns
      rather than fails, since a stale bridge runs and work on the managed side alone goes on with
      it, and it runs before the build so the line comes first. Where no build ran here, as in the
      workflow's jobs that download a bridge into its slot, there is nothing to compare and it says
      nothing.

      The line names the first of the newer files and counts the others, since one rebuild answers
      them all. A property batched over the files cannot carry the newest of them from one file to
      the next, each file's batch reading the property as it stood before any of them, so the first
      is taken from the list. MSBuild runs a skipped target's property and item groups too, to know
      what it would have made, so nothing there reads a file it is not sure is there.
    -->
    <PropertyGroup>
        <BevyCSharpDevNative>$(BevyCSharpNativeOutDir)libbevy_csharp.so</BevyCSharpDevNative>
        <BevyCSharpDevNative Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(BevyCSharpNativeOutDir)bevy_csharp.dll</BevyCSharpDevNative>
        <BevyCSharpDevNative Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(BevyCSharpNativeOutDir)libbevy_csharp.dylib</BevyCSharpDevNative>
    </PropertyGroup>
    <Target Name="BevyCSharpWarnNativeIsStale"
            BeforeTargets="BeforeBuild"
            Condition="'$(BevyCSharpSkipNativeFreshnessCheck)' != 'true' And Exists('$(BevyCSharpDevNative)')"
            Inputs="@(BevyCSharpNativeSource)"
            Outputs="$(BevyCSharpDevNative)">

        <PropertyGroup>
            <_BevyCSharpDevNativeTime>$([System.IO.File]::GetLastWriteTime('$(BevyCSharpDevNative)').ToUniversalTime().Ticks)</_BevyCSharpDevNativeTime>
        </PropertyGroup>
        <ItemGroup>
            <_BevyCSharpNewerNativeSource Include="@(BevyCSharpNativeSource)"
                                          Condition="$([System.IO.File]::GetLastWriteTime('%(FullPath)').ToUniversalTime().Ticks) &gt; $(_BevyCSharpDevNativeTime)"/>
        </ItemGroup>
        <PropertyGroup>
            <_BevyCSharpNewer>@(_BevyCSharpNewerNativeSource->'%(FullPath)')</_BevyCSharpNewer>
            <_BevyCSharpFirstNewer>$(_BevyCSharpNewer)</_BevyCSharpFirstNewer>
            <_BevyCSharpFirstNewer Condition="$(_BevyCSharpNewer.Contains(';'))">$(_BevyCSharpNewer.Substring(0, $(_BevyCSharpNewer.IndexOf(';'))))</_BevyCSharpFirstNewer>
            <_BevyCSharpNewerCount>@(_BevyCSharpNewerNativeSource->Count())</_BevyCSharpNewerCount>
            <_BevyCSharpOthers>$([MSBuild]::Subtract($(_BevyCSharpNewerCount), 1))</_BevyCSharpOthers>
            <_BevyCSharpAndOthers Condition="'$(_BevyCSharpOthers)' == '1'"> and 1 other file</_BevyCSharpAndOthers>
            <_BevyCSharpAndOthers Condition="'$(_BevyCSharpOthers)' &gt; '1'"> and $(_BevyCSharpOthers) other files</_BevyCSharpAndOthers>
        </PropertyGroup>

        <Warning Condition="'$(_BevyCSharpNewerCount)' != '0'"
                 Code="BCS102"
                 Text="The native bridge in $(BevyCSharpNativeOutDir) is older than $([MSBuild]::MakeRelative('$(BevyCSharpNativeDir)', '$(_BevyCSharpFirstNewer)'))$(_BevyCSharpAndOthers) in $(BevyCSharpNativeDir) it is built from, so what runs leaves out what changed since it was built. Rebuild it with build/build-native.sh and the profile it was built with, or with ./bcs build, which builds both halves."/>
    </Target>





















    <!--
      The projects above this one that reach its internals, each under what it reaches.
    -->
    <ItemGroup>
        <!-- Native -->
        <InternalsVisibleTo Include="BevyCSharp.Animation"/>
        <!-- Native -->
        <InternalsVisibleTo Include="BevyCSharp.Assets"/>
        <!-- Native -->
        <InternalsVisibleTo Include="BevyCSharp.Audio"/>
        <!-- Native -->
        <InternalsVisibleTo Include="BevyCSharp.CliServer"/>
        <!-- Native, NativeRowGuard -->
        <InternalsVisibleTo Include="BevyCSharp.Core"/>
        <!-- Native -->
        <InternalsVisibleTo Include="BevyCSharp.Diagnostics"/>
        <!-- Native -->
        <InternalsVisibleTo Include="BevyCSharp.Gizmos"/>
        <!-- Native, NativeFieldDraw, NativeFieldEye, NativeGiLights, NativeSceneCounts -->
        <InternalsVisibleTo Include="BevyCSharp.GlobalIllumination"/>
        <!-- Native -->
        <InternalsVisibleTo Include="BevyCSharp.ImGui"/>
        <!-- Native, NativeTilemapChunk -->
        <InternalsVisibleTo Include="BevyCSharp.Render2d"/>
        <!-- Native, NativeDenoiserSettings -->
        <InternalsVisibleTo Include="BevyCSharp.Rendering"/>
        <!-- Native -->
        <InternalsVisibleTo Include="BevyCSharp.Scenes"/>
        <!-- Native -->
        <InternalsVisibleTo Include="BevyCSharp.Sky"/>
        <!-- Native -->
        <InternalsVisibleTo Include="BevyCSharp.Ui"/>
    </ItemGroup>

</Project>
