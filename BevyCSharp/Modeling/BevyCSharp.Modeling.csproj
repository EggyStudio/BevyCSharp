<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>BevyCSharp's modeling, EditMesh, a mesh shaped by operations through a selection.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Core/BevyCSharp.Core.csproj"/>
        <ProjectReference Include="../Assets/BevyCSharp.Assets.csproj"/>
        <ProjectReference Include="../Rendering/BevyCSharp.Rendering.csproj"/>
        <ProjectReference Include="../Gizmos/BevyCSharp.Gizmos.csproj"/>
        <ProjectReference Include="../ImGui/BevyCSharp.ImGui.csproj"/>
        <ProjectReference Include="../Physics/BevyCSharp.Physics.csproj"/>
    </ItemGroup>

    <!--
      The Vegetation module both engines share, a git submodule under modules/, kept out of what
      a project referencing this one sees, since the module is not a package of its own. The
      flat project's package carries its assembly in its lib folder beside the areas'.
    -->
    <ItemGroup>
        <ProjectReference Include="../../modules/Vegetation/Vegetation/Vegetation.csproj" PrivateAssets="all"/>
    </ItemGroup>



    <!--
      The projects above this one that reach its internals, each under what it reaches.
    -->
    <ItemGroup>
        <!-- ModelingWork -->
        <InternalsVisibleTo Include="BevyCSharp"/>
        <!-- Modeling.PrototypePicture -->
        <InternalsVisibleTo Include="BevyCSharp.Levels"/>
    </ItemGroup>

</Project>
