<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bevy</RootNamespace>
        <AssemblyName>BevyCSharp</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>BevyCSharp</PackageId>
        <Title>BevyCSharp</Title>
        <Description>
            Write Bevy games in C#. Mark a struct [Behavior], give it [OnUpdate] methods, and a
            source generator wires it into the Bevy schedule as both a component and a system.
            Bevy is the engine underneath - its ECS, scheduler, renderer and input, reached
            through a native bridge.
        </Description>
        <PackageTags>bevy;ecs;gamedev;engine;source-generator;behavior</PackageTags>
        <!-- The generator and the native binaries are carried inside this package. -->
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <DevelopmentDependency>false</DevelopmentDependency>
    </PropertyGroup>

    <!--
      The generator runs against the consumer's compilation. It is referenced as an analyzer
      (never as a library) so its Roslyn dependencies never leak into the consumer's closure.
    -->
    <ItemGroup>
        <ProjectReference Include="../BevyCSharp.Generator/BevyCSharp.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- Ship the generator in the package's analyzer slot. -->
    <ItemGroup>
        <None Include="../BevyCSharp.Generator/bin/$(Configuration)/netstandard2.0/BevyCSharp.Generator.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/"
              Visible="false"/>
    </ItemGroup>

    <!-- MSBuild logic the consuming project needs (native probing paths). -->
    <ItemGroup>
        <None Include="build/BevyCSharp.targets" Pack="true" PackagePath="build/" Visible="false"/>
        <None Include="build/BevyCSharp.props" Pack="true" PackagePath="build/" Visible="false"/>
    </ItemGroup>

    <!--
      Native runtime assets, staged per RID by build/build-native.sh. A missing slot is skipped
      rather than failing the build, so you can pack on one platform without cross-compiling for
      all the others.
    -->
    <ItemGroup>
        <None Include="$(BevyCSharpArtifactDir)linux-x64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)linux-x64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpArtifactDir)linux-arm64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)linux-arm64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpArtifactDir)win-x64/bevy_csharp.dll"
              Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)win-x64/bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpArtifactDir)win-arm64/bevy_csharp.dll"
              Pack="true" PackagePath="runtimes/win-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)win-arm64/bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpArtifactDir)osx-arm64/libbevy_csharp.dylib"
              Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)osx-arm64/libbevy_csharp.dylib')"/>
        <None Include="$(BevyCSharpArtifactDir)osx-x64/libbevy_csharp.dylib"
              Pack="true" PackagePath="runtimes/osx-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)osx-x64/libbevy_csharp.dylib')"/>
    </ItemGroup>

    <!--
      Repo-local development: copy whatever the last cargo build produced next to the sample and
      test binaries, so running them works without packing first.
    -->
    <ItemGroup>
        <None Include="$(BevyCSharpNativeOutDir)libbevy_csharp.so"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpNativeOutDir)libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpNativeOutDir)bevy_csharp.dll"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpNativeOutDir)bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpNativeOutDir)libbevy_csharp.dylib"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpNativeOutDir)libbevy_csharp.dylib')"/>
    </ItemGroup>

    <!--
      The native bridge is built by cargo, not by MSBuild, so nothing forces it to be current.
      A stale artifact is a nasty failure to diagnose: the ABI version still matches, but an
      entry point added since it was staged is missing, and the app dies on the first call to it
      with an EntryPointNotFoundException far from the cause.

      Inputs/Outputs give this for free - MSBuild skips a target whose outputs are all newer
      than its inputs, so the body below runs only when the staged bridge is actually stale.
    -->
    <ItemGroup>
        <BevyCSharpRustSource Include="$(BevyCSharpNativeDir)bevy_csharp/src/**/*.rs"/>
        <BevyCSharpRustSource Include="$(BevyCSharpNativeDir)bevy_csharp/Cargo.toml"/>
        <BevyCSharpStagedNative Include="$(BevyCSharpArtifactDir)**/libbevy_csharp.so"/>
        <BevyCSharpStagedNative Include="$(BevyCSharpArtifactDir)**/bevy_csharp.dll"/>
        <BevyCSharpStagedNative Include="$(BevyCSharpArtifactDir)**/libbevy_csharp.dylib"/>
    </ItemGroup>

    <Target Name="BevyCSharpVerifyNativeIsCurrent"
            BeforeTargets="GenerateNuspec"
            Inputs="@(BevyCSharpRustSource)"
            Outputs="@(BevyCSharpStagedNative)">

        <Warning Condition="'@(BevyCSharpStagedNative)' == ''"
                 Code="BCS100"
                 Text="No native bridge has been staged in $(BevyCSharpArtifactDir), so this package will carry no runtime assets and will not run. Run build/build-native.sh before packing."/>

        <Error Condition="'@(BevyCSharpStagedNative)' != ''"
               Code="BCS101"
               Text="The staged native bridge in $(BevyCSharpArtifactDir) is older than the Rust sources in $(BevyCSharpNativeDir). Re-run build/build-native.sh before packing, or the package will ship a bridge missing the newest entry points."/>
    </Target>

</Project>
