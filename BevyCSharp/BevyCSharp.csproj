<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>BevyCSharp</AssemblyName>
        <PackageId>BevyCSharp</PackageId>
        <IsPackable>true</IsPackable>
        <Title>BevyCSharp</Title>
        <PackageTags>bevy;ecs;gamedev;engine;source-generator;behavior</PackageTags>
        <Description>
            Write Bevy games in C#. Mark a struct [Behavior], give it [OnUpdate] methods, and a
            source generator registers it with the Bevy schedule as both a component and a system.
            Bevy is the engine underneath, providing its ECS, scheduler, renderer and input
            through a native bridge.
        </Description>
        <!--
          The commits since the package nuget.org lists last was built, which build/release-notes.py
          writes to the file a pack names.
        -->
        <PackageReleaseNotes Condition="'$(ReleaseNotesFile)' != '' And Exists('$(ReleaseNotesFile)')">$([System.IO.File]::ReadAllText('$(ReleaseNotesFile)'))</PackageReleaseNotes>
        <!--
          The areas' projects are folders below this one, each compiled by its own project, so this
          one compiles the files at the top alone, which compose the rest.
        -->
        <DefaultItemExcludes>$(DefaultItemExcludes);*/**</DefaultItemExcludes>
    </PropertyGroup>

    <!--
      Every area's project. The package carries each one's assembly and documentation in its lib
      folder beside this project's, so a game names this package alone, and none of them is a
      dependency of the package. NuGet writes a dependency for each project reference the restore
      does not hold private, so while packing, which dotnet pack marks with _IsPacking for its
      restore and its pack alike, every reference is private, and otherwise each project of the
      repository referencing this one sees every area through it.
    -->
    <ItemDefinitionGroup Condition="'$(_IsPacking)' == 'true'">
        <ProjectReference>
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemDefinitionGroup>
    <ItemGroup>
        <ProjectReference Include="Native/BevyCSharp.Native.csproj"/>
        <ProjectReference Include="Core/BevyCSharp.Core.csproj"/>
        <ProjectReference Include="Assets/BevyCSharp.Assets.csproj"/>
        <ProjectReference Include="Audio/BevyCSharp.Audio.csproj"/>
        <ProjectReference Include="Gizmos/BevyCSharp.Gizmos.csproj"/>
        <ProjectReference Include="ImGui/BevyCSharp.ImGui.csproj"/>
        <ProjectReference Include="Cli/BevyCSharp.CliServer.csproj"/>
        <ProjectReference Include="Rendering/BevyCSharp.Rendering.csproj"/>
        <ProjectReference Include="Render2d/BevyCSharp.Render2d.csproj"/>
        <ProjectReference Include="Animation/BevyCSharp.Animation.csproj"/>
        <ProjectReference Include="GlobalIllumination/BevyCSharp.GlobalIllumination.csproj"/>
        <ProjectReference Include="Scenes/BevyCSharp.Scenes.csproj"/>
        <ProjectReference Include="Ui/BevyCSharp.Ui.csproj"/>
        <ProjectReference Include="Physics/BevyCSharp.Physics.csproj"/>
        <ProjectReference Include="Sky/BevyCSharp.Sky.csproj"/>
        <ProjectReference Include="Modeling/BevyCSharp.Modeling.csproj"/>
        <ProjectReference Include="Diagnostics/BevyCSharp.Diagnostics.csproj"/>
        <ProjectReference Include="Vegetation/BevyCSharp.Vegetation.csproj"/>
        <ProjectReference Include="Levels/BevyCSharp.Levels.csproj"/>
    </ItemGroup>

    <!--
      The modules both engines share, each its own repository checked out as a git submodule under
      modules/, which the areas reference and keep to themselves. The package carries their
      assemblies beside the areas', since the modules are not packages of their own.
    -->
    <ItemGroup>
        <ProjectReference Include="../modules/Levels/Levels/Levels.csproj" PrivateAssets="all"/>
        <ProjectReference Include="../modules/Sky/Sky/Sky.csproj" PrivateAssets="all"/>
        <ProjectReference Include="../modules/Vegetation/Vegetation/Vegetation.csproj" PrivateAssets="all"/>
    </ItemGroup>

    <!--
      The packages from outside that the areas build on, named again here, since a package depends
      on what its own project names and the areas are not packages. N 6.4 holds each to the
      version its area names.
    -->
    <ItemGroup>
        <PackageReference Include="Twizzle.ImGui-Bundle.NET" Version="1.91.5.2"/>
        <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29"/>
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BevyCSharpCarryProjects</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>
    <Target Name="BevyCSharpCarryProjects" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <_BevyCSharpCarried Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'"/>
            <BuildOutputInPackage Include="@(_BevyCSharpCarried)"/>
            <BuildOutputInPackage Include="@(_BevyCSharpCarried->'%(RootDir)%(Directory)%(Filename).xml')"
                                  Condition="Exists('%(RootDir)%(Directory)%(Filename).xml')"/>
        </ItemGroup>
    </Target>

    <!--
      The bridge for each platform, staged per runtime by build/build-native.sh, in the package's
      runtimes folder. A missing slot is skipped rather than failing the build, so you can pack on
      one platform without cross-compiling for all the others. The bridge's project checks the
      staged ones against what they are built from before the nuspec is written.
    -->
    <ItemGroup>
        <None Include="$(BevyCSharpArtifactDir)linux-x64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)linux-x64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpArtifactDir)linux-arm64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)linux-arm64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpArtifactDir)linux-musl-x64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-musl-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)linux-musl-x64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpArtifactDir)linux-musl-arm64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-musl-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)linux-musl-arm64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpArtifactDir)win-x64/bevy_csharp.dll"
              Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)win-x64/bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpArtifactDir)win-arm64/bevy_csharp.dll"
              Pack="true" PackagePath="runtimes/win-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)win-arm64/bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpArtifactDir)osx-x64/libbevy_csharp.dylib"
              Pack="true" PackagePath="runtimes/osx-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)osx-x64/libbevy_csharp.dylib')"/>
        <None Include="$(BevyCSharpArtifactDir)osx-arm64/libbevy_csharp.dylib"
              Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpArtifactDir)osx-arm64/libbevy_csharp.dylib')"/>
    </ItemGroup>
    <Target Name="BevyCSharpVerifyCarriedNative" BeforeTargets="GenerateNuspec" Condition="'$(BevyCSharpSkipNativeFreshnessCheck)' != 'true'">
        <MSBuild Projects="Native/BevyCSharp.Native.csproj" Targets="BevyCSharpVerifyNativeIsCurrent"/>
    </Target>

    <!--
      The fixes an editor offers for the generator's diagnostics, built before the package is packed
      and carried beside it, and neither referenced nor run by the library's own build.
    -->
    <ItemGroup>
        <ProjectReference Include="../BevyCSharp.CodeFixes/BevyCSharp.CodeFixes.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"/>
    </ItemGroup>

    <!--
      The generator and its code fixes in this package's analyzer slot, so they run against the
      game that names it.
    -->
    <ItemGroup>
        <None Include="../BevyCSharp.Generator/bin/$(Configuration)/netstandard2.0/BevyCSharp.Generator.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/"
              Visible="false"/>
        <None Include="../BevyCSharp.CodeFixes/bin/$(Configuration)/netstandard2.0/BevyCSharp.CodeFixes.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/"
              Visible="false"/>
    </ItemGroup>

    <!-- MSBuild logic the consuming project needs (native probing paths). -->
    <ItemGroup>
        <None Include="build/BevyCSharp.targets" Pack="true" PackagePath="build/" Visible="false"/>
        <None Include="build/BevyCSharp.props" Pack="true" PackagePath="build/" Visible="false"/>
        <None Include="build/BevyCSharp.Embed.targets" Pack="true" PackagePath="build/" Visible="false"/>
    </ItemGroup>

</Project>
