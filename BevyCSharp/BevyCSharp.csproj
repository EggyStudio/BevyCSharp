<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>BevyCSharp</AssemblyName>
        <PackageId>BevyCSharp</PackageId>
        <Title>BevyCSharp</Title>
        <Description>
            Write Bevy games in C#. Mark a struct [Behavior], give it [OnUpdate] methods, and a
            source generator registers it with the Bevy schedule as both a component and a system.
            Bevy is the engine underneath, providing its ECS, scheduler, renderer and input
            through a native bridge.
        </Description>
        <!--
          The commits since the package nuget.org lists last was built, which build/release-notes.py
          writes to the file a pack names.
        -->
        <PackageReleaseNotes Condition="'$(ReleaseNotesFile)' != '' And Exists('$(ReleaseNotesFile)')">$([System.IO.File]::ReadAllText('$(ReleaseNotesFile)'))</PackageReleaseNotes>
        <!--
          The areas' projects are folders below this one, each compiled by its own project, so this
          one compiles the files at the top alone, which compose the rest.
        -->
        <DefaultItemExcludes>$(DefaultItemExcludes);*/**</DefaultItemExcludes>
    </PropertyGroup>

    <!--
      Every area's project, so this is the package a game names and the areas come as its
      dependencies, each at this package's version.
    -->
    <ItemGroup>
        <ProjectReference Include="Native/BevyCSharp.Native.csproj"/>
        <ProjectReference Include="Core/BevyCSharp.Core.csproj"/>
        <ProjectReference Include="Assets/BevyCSharp.Assets.csproj"/>
        <ProjectReference Include="Audio/BevyCSharp.Audio.csproj"/>
        <ProjectReference Include="Gizmos/BevyCSharp.Gizmos.csproj"/>
        <ProjectReference Include="ImGui/BevyCSharp.ImGui.csproj"/>
        <ProjectReference Include="Cli/BevyCSharp.CliServer.csproj"/>
        <ProjectReference Include="Rendering/BevyCSharp.Rendering.csproj"/>
        <ProjectReference Include="Render2d/BevyCSharp.Render2d.csproj"/>
        <ProjectReference Include="Animation/BevyCSharp.Animation.csproj"/>
        <ProjectReference Include="GlobalIllumination/BevyCSharp.GlobalIllumination.csproj"/>
        <ProjectReference Include="Scenes/BevyCSharp.Scenes.csproj"/>
        <ProjectReference Include="Ui/BevyCSharp.Ui.csproj"/>
        <ProjectReference Include="Physics/BevyCSharp.Physics.csproj"/>
        <ProjectReference Include="Sky/BevyCSharp.Sky.csproj"/>
        <ProjectReference Include="Modeling/BevyCSharp.Modeling.csproj"/>
        <ProjectReference Include="Diagnostics/BevyCSharp.Diagnostics.csproj"/>
        <ProjectReference Include="Vegetation/BevyCSharp.Vegetation.csproj"/>
        <ProjectReference Include="Levels/BevyCSharp.Levels.csproj"/>
    </ItemGroup>

    <!--
      The fixes an editor offers for the generator's diagnostics, built before the package is packed
      and carried beside it, and neither referenced nor run by the library's own build.
    -->
    <ItemGroup>
        <ProjectReference Include="../BevyCSharp.CodeFixes/BevyCSharp.CodeFixes.csproj"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all"/>
    </ItemGroup>

    <!--
      The generator and its code fixes in this package's analyzer slot, so they run against the
      game that names it.
    -->
    <ItemGroup>
        <None Include="../BevyCSharp.Generator/bin/$(Configuration)/netstandard2.0/BevyCSharp.Generator.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/"
              Visible="false"/>
        <None Include="../BevyCSharp.CodeFixes/bin/$(Configuration)/netstandard2.0/BevyCSharp.CodeFixes.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/"
              Visible="false"/>
    </ItemGroup>

    <!-- MSBuild logic the consuming project needs (native probing paths). -->
    <ItemGroup>
        <None Include="build/BevyCSharp.targets" Pack="true" PackagePath="build/" Visible="false"/>
        <None Include="build/BevyCSharp.props" Pack="true" PackagePath="build/" Visible="false"/>
        <None Include="build/BevyCSharp.Embed.targets" Pack="true" PackagePath="build/" Visible="false"/>
    </ItemGroup>

</Project>
