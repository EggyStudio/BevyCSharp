<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bevy.Physics</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageId>BevyCSharp.Physics</PackageId>
        <Description>Rigid bodies for BevyCSharp, simulated by BepuPhysics on the managed side.</Description>
        <PackageTags>bevy;physics;bepu;gamedev</PackageTags>
    </PropertyGroup>

    <!--
      A package of its own, so the core takes no dependency on a physics engine. Bepu is C#, so the
      simulation lives on this side and nothing new crosses to the native bridge. It is on a beta
      line, and the version is pinned rather than floating so an update is a decision.
    -->
    <ItemGroup>
        <ProjectReference Include="../BevyCSharp/BevyCSharp.csproj"/>
        <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29"/>
    </ItemGroup>

</Project>
