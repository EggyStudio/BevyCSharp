<Project Sdk="Microsoft.NET.Sdk">

    <!--
      A level blocked out with the engine's modeling tools and walked in, made the way a game outside
      this repository is made, from the BevyCSharp package and nothing of the repository's own projects.
      Its level is a recipe in assets, rebuilt as the game loads, and its behaviors are the scripts
      beside it.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!--
          The newest version published on nuget.org this game builds on, raised in a commit after a
          publish (BUILDING.md). A build names another with -p:BevyCSharpVersion, as continuous
          integration does with the package it packs for the run.
        -->
        <BevyCSharpVersion Condition="'$(BevyCSharpVersion)' == ''">0.5.193</BevyCSharpVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BevyCSharp" Version="$(BevyCSharpVersion)" />
    </ItemGroup>

</Project>
