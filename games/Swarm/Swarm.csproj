<Project Sdk="Microsoft.NET.Sdk">

    <!--
      An arena held against waves of hundreds of creatures, made as a game outside this repository is
      made, from the BevyCSharp package alone, every behavior of it in assets/scripts.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!--
          The newest version published on nuget.org this game builds on, raised in a commit after a
          publish (BUILDING.md). A build names another with -p:BevyCSharpVersion, as continuous
          integration does with the package it packs for the run. A version the feed never had
          resolves to the next one up with NuGet's warning NU1603, which a build without warnings
          fails on, as 0.5.0 did on the pack run of 3b0e54d7.
        -->
        <BevyCSharpVersion Condition="'$(BevyCSharpVersion)' == ''">0.5.174</BevyCSharpVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BevyCSharp" Version="$(BevyCSharpVersion)" />
    </ItemGroup>

</Project>
