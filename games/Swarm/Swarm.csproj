<Project Sdk="Microsoft.NET.Sdk">

    <!--
      An arena held against waves of hundreds of creatures, made as a game outside this repository is
      made, from the BevyCSharp package alone, every behavior of it in assets/scripts.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!--
          The version packed into build/package, which a build can name instead, as continuous
          integration does with the package it packs for the run.
        -->
        <BevyCSharpVersion Condition="'$(BevyCSharpVersion)' == ''">0.0.14-game</BevyCSharpVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BevyCSharp" Version="$(BevyCSharpVersion)" />
    </ItemGroup>

</Project>
