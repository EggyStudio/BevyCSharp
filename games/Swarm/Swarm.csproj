<Project Sdk="Microsoft.NET.Sdk">

    <!--
      An arena held against waves of hundreds of creatures, made as a game outside this repository is
      made, from the BevyCSharp package alone, every behavior of it in assets/scripts.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!--
          The first package of 0.5 or later, which NuGet takes as the lowest published version at or
          past it, since the game calls MainThread, which no version published before 0.5 carries.
          Until one is published the game is built on a pack of the checkout under a version of its
          own, named with -p:BevyCSharpVersion, as BUILDING.md shows and continuous integration does
          with the package it packs for the run.
        -->
        <BevyCSharpVersion Condition="'$(BevyCSharpVersion)' == ''">0.5.0</BevyCSharpVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BevyCSharp" Version="$(BevyCSharpVersion)" />
    </ItemGroup>

</Project>
