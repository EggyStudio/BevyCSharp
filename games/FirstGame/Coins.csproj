<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The game docs/first-game.md makes from an empty folder, a step at a time, from the BevyCSharp
      package alone. Program.cs is the finished game, and steps/ holds every step of it as a whole
      program, which build/first-game.sh builds and runs one at a time in a copy of this project.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!--
          The newest version published on nuget.org this game builds on, raised in a commit after a
          publish (BUILDING.md). A build names another with -p:BevyCSharpVersion, as continuous
          integration does with the package it packs for the run.
        -->
        <BevyCSharpVersion Condition="'$(BevyCSharpVersion)' == ''">0.5.174</BevyCSharpVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BevyCSharp" Version="$(BevyCSharpVersion)" />

        <!-- Each step is a program of its own, built alone in place of Program.cs. -->
        <Compile Remove="steps/**" />
    </ItemGroup>

</Project>
