<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The packages this repository packs (build/pack.sh -c Release, into
    build/package), ahead of nuget.org, so the game builds on what was packed rather than on the
    library's project.
  -->
  <packageSources>
    <add key="local" value="../../build/package" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
