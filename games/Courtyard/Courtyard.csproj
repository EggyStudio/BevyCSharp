<Project Sdk="Microsoft.NET.Sdk">

    <!--
      A small game made the way a game outside this repository is made: the BevyCSharp package and
      nothing of the repository's own projects. Its level and behaviors are in assets, edited in
      the editor opened on this folder with its project option.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!--
          The newest version published on nuget.org this game builds on, raised in a commit after a
          publish (BUILDING.md). A build names another with -p:BevyCSharpVersion, as continuous
          integration does with the package it packs for the run.
        -->
        <BevyCSharpVersion Condition="'$(BevyCSharpVersion)' == ''">0.4.129</BevyCSharpVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BevyCSharp" Version="$(BevyCSharpVersion)" />
    </ItemGroup>

</Project>
