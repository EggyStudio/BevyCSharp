<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>BevyCSharp.Sample</RootNamespace>
    </PropertyGroup>

    <!--
      In a real consuming project this is a single <PackageReference Include="BevyCSharp" />.
      Inside the repo the package is not built yet, so the library and the generator are wired
      up by hand exactly the way the package wires them: the library as a reference, the
      generator as an analyzer.
    -->
    <ItemGroup>
        <ProjectReference Include="../../src/BevyCSharp/BevyCSharp.csproj"/>
        <ProjectReference Include="../../src/BevyCSharp.Generator/BevyCSharp.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
