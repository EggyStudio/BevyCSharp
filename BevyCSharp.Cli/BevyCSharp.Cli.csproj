<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>BevyCSharp.Cli</RootNamespace>
        <AssemblyName>bcs</AssemblyName>
        <!-- Documented in the skill and the README rather than in XML docs: nothing here is API. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
      Installable as `bcs` with `dotnet tool install`, for use outside a checkout: pack this
      project, then install it globally from build/package. Inside the checkout the `bcs` script
      at the repository root runs the built binary directly, so nothing has to be installed.
    -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>bcs</ToolCommandName>
        <PackageId>BevyCSharp.Cli</PackageId>
        <Description>Drives a running BevyCSharp app from the command line.</Description>
    </PropertyGroup>

    <!--
      The library, for the session file and the envelope: the shapes the app writes are the shapes
      this reads, and a second copy of either is a second thing to keep in step.
    -->
    <ItemGroup>
        <ProjectReference Include="../BevyCSharp/BevyCSharp.csproj"/>
    </ItemGroup>

</Project>
