<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>BevyCSharp.Editor</RootNamespace>
    </PropertyGroup>

    <!--
      The same wiring BevyCSharp.Sample uses: the library as a reference and the generator as an
      analyzer. The analyzer line is required rather than tidy, because analyzers are per
      compilation: without it the panels in this project generate nothing and bind to nothing.
    -->
    <!--
      Roslyn, for compiling behavior scripts while the editor runs. It lives here rather than in
      the runtime library on purpose: a game does not compile C# at runtime and should not carry
      a compiler to do it, while an editor is the one place that has to.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../BevyCSharp/BevyCSharp.csproj"/>
        <!--
          Referenced as well as loaded as an analyzer, which the sample does not do. The editor
          needs both: the analyzer half generates this project's own panels and behaviors, and
          the reference half lets the script host run the same generator over a script it
          compiles while the editor is running. A script has to become a behavior the same way
          everything else does, not a second way that drifts.
        -->
        <ProjectReference Include="../BevyCSharp.Generator/BevyCSharp.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="true"/>
    </ItemGroup>

    <!--
      Panels are three files: structure in HTML, appearance in CSS, behavior in C#. The first two
      are assets so they can be edited without rebuilding, which is what makes the shipped editor
      a starting point rather than a fixed one. The destination is spelled out rather than left to
      LinkBase, which not every build host applies the same way.
    -->
    <ItemGroup>
        <None Include="assets/**" CopyToOutputDirectory="PreserveNewest"
              Link="assets/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <!--
      Scripts are compiled while the editor runs, not while it is built. Without this the SDK's
      default glob picks them up as ordinary source and every script exists twice: once baked into
      this assembly and registered at startup, and once loaded by the script host. Both run, and
      editing the file only changes one of them.
    -->
    <ItemGroup>
        <Compile Remove="assets/**/*.cs"/>
    </ItemGroup>

</Project>
