<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>BevyCSharp.Examples</RootNamespace>
        <!-- An example is a program to read beside Bevy's, and its members say what they do in the
             names Bevy's do, so they carry no XML documentation of their own. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Wired up as the sample is, the library as a reference and the generator as an analyzer,
         which is what the package does for a game. -->
    <ItemGroup>
        <ProjectReference Include="../BevyCSharp/BevyCSharp.csproj"/>
        <ProjectReference Include="../BevyCSharp.Generator/BevyCSharp.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- The triage is read by build/examples-table.py and is not part of the program. -->
    <ItemGroup>
        <None Remove="triage.tsv"/>
        <None Include="assets/**" CopyToOutputDirectory="PreserveNewest"
              Link="assets/%(RecursiveDir)%(Filename)%(Extension)"/>
        <!-- Bevy's own, fetched by build/fetch-bevy-assets.sh, at the paths its examples load. -->
        <None Include="bevy-assets/**" CopyToOutputDirectory="PreserveNewest"
              Link="assets/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <!-- The picture embedded_asset carries in the program rather than beside it, named as an asset
         is under the asset root, which is how a game's assembly carries the assets it ships. -->
    <ItemGroup>
        <EmbeddedResource Include="bevy-assets/pixel/bevy_pixel_light.png"
                          LogicalName="assets/embedded_asset/files/bevy_pixel_light.png"
                          WithCulture="false"
                          Condition="Exists('bevy-assets/pixel/bevy_pixel_light.png')"/>
    </ItemGroup>

</Project>
