<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bevy.Scripting</RootNamespace>
    </PropertyGroup>

    <!--
      Compiling behavior scripts while an app runs, shared by the editor and the player that plays
      the scene being edited. Its own project rather than part of the library, because it carries
      Roslyn, and a shipped game compiles its scripts ahead of time and has no reason to carry a
      compiler. The editor and the player reference it, and so can a game that references the
      project, which the package leaves out.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../BevyCSharp/BevyCSharp.csproj"/>
        <!--
          Referenced as well as loaded as an analyzer, as the editor does. The reference half runs
          the generator over the scripts this compiles, so a script becomes a behavior the same way
          a compiled one does, and the analyzer half registers this project's own commands.
        -->
        <ProjectReference Include="../BevyCSharp.Generator/BevyCSharp.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="true"/>
    </ItemGroup>

</Project>
