<Project>

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Generated behavior runners are internal plumbing; they need no XML docs. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>EggyStudio</Authors>
        <Company>EggyStudio</Company>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/EggyStudio/BevyCSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/EggyStudio/BevyCSharp</PackageProjectUrl>
        <VersionPrefix>0.1.0</VersionPrefix>
        <IsPackable>false</IsPackable>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!--
      Where the Rust workspace lives, and where its output goes.

      Sources are in native/; everything generated (cargo's target directory and the staged
      per-RID artifacts) goes under build/, so the repository root stays clean. Both must agree
      with build/build-native.sh, which is what actually writes them.
    -->
    <PropertyGroup>
        <BevyCSharpRoot>$(MSBuildThisFileDirectory)</BevyCSharpRoot>
        <BevyCSharpNativeDir>$(BevyCSharpRoot)native/</BevyCSharpNativeDir>
        <BevyCSharpBuildDir>$(BevyCSharpRoot)build/</BevyCSharpBuildDir>
        <BevyCSharpArtifactDir>$(BevyCSharpBuildDir)artifacts/</BevyCSharpArtifactDir>
        <BevyCSharpNativeOutDir>$(BevyCSharpBuildDir)target/release/</BevyCSharpNativeOutDir>
        <BevyCSharpIcon>$(BevyCSharpRoot).github/assets/icon.png</BevyCSharpIcon>
        <BevyCSharpReadme>$(BevyCSharpRoot)README.md</BevyCSharpReadme>
    </PropertyGroup>

    <!--
      The icon and readme shown on the package page, taken from where the repository already
      keeps them rather than duplicated next to the project.

      This has to come after the property group above, because MSBuild evaluates a file top to
      bottom and the paths would otherwise still be empty. A blank PackagePath means the package
      root, so each file lands under the bare name that PackageIcon and PackageReadmeFile expect.
      The Exists guards stop a missing asset from breaking every build in the tree; the pack
      itself still fails loudly, because NuGet rejects metadata naming a file it cannot find.
    -->
    <ItemGroup>
        <None Include="$(BevyCSharpIcon)" Pack="true" PackagePath="" Visible="false"
              Condition="Exists('$(BevyCSharpIcon)')"/>
        <None Include="$(BevyCSharpReadme)" Pack="true" PackagePath="" Visible="false"
              Condition="Exists('$(BevyCSharpReadme)')"/>
    </ItemGroup>

    <!--
      Send packages to build/package too, so a bare `dotnet pack` does not drop a folder in the
      repository root. An explicit `-o` on the command line still wins.
    -->
    <PropertyGroup>
        <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(BevyCSharpBuildDir)package/</PackageOutputPath>
    </PropertyGroup>

</Project>
