<Project>

    <!--
      Imported into every project that references the BevyCSharp package.

      NuGet already copies runtimes/<rid>/native/ for a RID-specific build or publish. This
      target covers the plain, RID-less `dotnet build` that most people start with, where the
      native asset would otherwise stay in the package folder and the app would fail at startup
      with "could not load bevy_csharp".
    -->

    <Target Name="BevyCSharpCopyNativeAssets"
            BeforeTargets="PrepareForRun"
            Condition="'$(BevyCSharpSkipNativeCopy)' != 'true'">

        <ItemGroup>
            <!--
              Every native asset the package resolved for this project, whatever RID NuGet
              picked. Copying all of them is harmless: only one matches at load time, and the
              resolver ignores the rest.
            -->
            <BevyCSharpNativeAsset Include="@(RuntimeTargetsCopyLocalItems)"
                                   Condition="'%(Filename)' == 'bevy_csharp' Or '%(Filename)' == 'libbevy_csharp'"/>
        </ItemGroup>

        <Copy SourceFiles="@(BevyCSharpNativeAsset)"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true"
              Condition="'@(BevyCSharpNativeAsset)' != ''"/>
    </Target>

    <!--
      A behaviour struct that is not partial, or whose fields are not blittable, is a compile
      error from the generator rather than a runtime surprise. Nothing to configure here - the
      generator ships in the package's analyzer slot and is picked up automatically.
    -->

</Project>
