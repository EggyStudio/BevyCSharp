<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bevy</RootNamespace>
        <AssemblyName>BevyCSharp</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>BevyCSharp</PackageId>
        <Title>BevyCSharp</Title>
        <Description>
            Write Bevy games in C#. Mark a struct [Behavior], give it [OnUpdate] methods, and a
            source generator wires it into the Bevy schedule as both a component and a system.
            Bevy is the engine underneath - its ECS, scheduler, renderer and input, reached
            through a native bridge.
        </Description>
        <PackageTags>bevy;ecs;gamedev;engine;source-generator;behavior</PackageTags>
        <!-- The generator and the native binaries are carried inside this package. -->
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <DevelopmentDependency>false</DevelopmentDependency>
    </PropertyGroup>

    <!--
      The generator runs against the consumer's compilation. It is referenced as an analyzer
      (never as a library) so its Roslyn dependencies never leak into the consumer's closure.
    -->
    <ItemGroup>
        <ProjectReference Include="../BevyCSharp.Generator/BevyCSharp.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- Ship the generator in the package's analyzer slot. -->
    <ItemGroup>
        <None Include="../BevyCSharp.Generator/bin/$(Configuration)/netstandard2.0/BevyCSharp.Generator.dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs/"
              Visible="false"/>
    </ItemGroup>

    <!-- MSBuild logic the consuming project needs (native probing paths). -->
    <ItemGroup>
        <None Include="build/BevyCSharp.targets" Pack="true" PackagePath="build/" Visible="false"/>
        <None Include="build/BevyCSharp.props" Pack="true" PackagePath="build/" Visible="false"/>
    </ItemGroup>

    <!--
      Native runtime assets. Each RID slot is populated by build/build-native.sh before packing;
      a missing slot is skipped rather than failing the build, so you can pack on one platform
      without cross-compiling for the others.
    -->
    <ItemGroup>
        <None Include="$(BevyCSharpNativeDir)artifacts/linux-x64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpNativeDir)artifacts/linux-x64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpNativeDir)artifacts/linux-arm64/libbevy_csharp.so"
              Pack="true" PackagePath="runtimes/linux-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpNativeDir)artifacts/linux-arm64/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpNativeDir)artifacts/win-x64/bevy_csharp.dll"
              Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpNativeDir)artifacts/win-x64/bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpNativeDir)artifacts/osx-arm64/libbevy_csharp.dylib"
              Pack="true" PackagePath="runtimes/osx-arm64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpNativeDir)artifacts/osx-arm64/libbevy_csharp.dylib')"/>
        <None Include="$(BevyCSharpNativeDir)artifacts/osx-x64/libbevy_csharp.dylib"
              Pack="true" PackagePath="runtimes/osx-x64/native/" Visible="false"
              Condition="Exists('$(BevyCSharpNativeDir)artifacts/osx-x64/libbevy_csharp.dylib')"/>
    </ItemGroup>

    <!--
      Repo-local development: copy whatever the local cargo build produced next to the test and
      sample binaries, so F5 works without packing first.
    -->
    <ItemGroup>
        <None Include="$(BevyCSharpNativeDir)target/release/libbevy_csharp.so"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpNativeDir)target/release/libbevy_csharp.so')"/>
        <None Include="$(BevyCSharpNativeDir)target/release/bevy_csharp.dll"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpNativeDir)target/release/bevy_csharp.dll')"/>
        <None Include="$(BevyCSharpNativeDir)target/release/libbevy_csharp.dylib"
              CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="false"
              Condition="Exists('$(BevyCSharpNativeDir)target/release/libbevy_csharp.dylib')"/>
    </ItemGroup>

    <!--
      The native bridge is built by cargo, not by MSBuild, so nothing forces it to be current.
      A stale artifact is a nasty failure: the versions still match, but a symbol added since it
      was staged is missing, and the app dies at the first call with an EntryPointNotFoundException.
      Comparing timestamps turns that into a build error naming the fix.
    -->
    <Target Name="BevyCSharpVerifyNativeIsCurrent" BeforeTargets="GenerateNuspec">
        <ItemGroup>
            <BevyCSharpRustSource Include="$(BevyCSharpNativeDir)bevy_csharp/src/**/*.rs"/>
            <BevyCSharpStagedNative Include="$(BevyCSharpNativeDir)artifacts/**/*"/>
        </ItemGroup>

        <PropertyGroup>
            <BevyCSharpNewestSource>%(BevyCSharpRustSource.ModifiedTime)</BevyCSharpNewestSource>
        </PropertyGroup>

        <Warning Condition="'@(BevyCSharpStagedNative)' == ''"
                 Text="No native bridge has been staged, so this package will contain no runtime assets. Run build/build-native.sh before packing."/>

        <Error Condition="'@(BevyCSharpStagedNative)' != '' And $([System.DateTime]::Parse('%(BevyCSharpStagedNative.ModifiedTime)').Ticks) &lt; $([System.DateTime]::Parse('$(BevyCSharpNewestSource)').Ticks)"
               Text="The staged native bridge (%(BevyCSharpStagedNative.Identity)) is older than the Rust sources. Re-run build/build-native.sh before packing, or the package will ship a bridge missing the newest entry points."/>
    </Target>

</Project>
