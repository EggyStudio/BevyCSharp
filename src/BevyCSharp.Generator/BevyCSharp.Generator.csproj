<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Roslyn loads analyzers into the compiler process, which targets netstandard2.0. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>Bevy.Generator</RootNamespace>
        <AssemblyName>BevyCSharp.Generator</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>false</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- RS2008 wants an AnalyzerReleases.md changelog; these ids ship with the package, not separately. -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all"/>
    </ItemGroup>

</Project>
