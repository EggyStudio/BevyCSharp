<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The package this repository packs (dotnet pack BevyCSharp/BevyCSharp.csproj -c Release, into
    build/package), ahead of nuget.org, for a build that names BevyCSharpVersion, so the feature
    test builds on what was packed rather than on the library's project.
  -->
  <packageSources>
    <add key="local" value="../build/package" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local"><package pattern="BevyCSharp" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
