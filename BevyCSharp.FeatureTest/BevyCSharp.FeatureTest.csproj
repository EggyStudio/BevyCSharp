<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>BevyCSharp.FeatureTest</RootNamespace>
    </PropertyGroup>

    <!--
      In a real consuming project this is a single <PackageReference Include="BevyCSharp" />.
      Inside the repo the package is not built yet, so the library and the generator are wired
      up by hand exactly the way the package wires them: the library as a reference, the
      generator as an analyzer.
    -->
    <ItemGroup Condition="'$(BevyCSharpVersion)' == ''">
        <ProjectReference Include="../BevyCSharp/BevyCSharp.csproj"/>
        <ProjectReference Include="../BevyCSharp.Generator/BevyCSharp.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!--
      A version named, as the testers' zips and the pack workflow name one packed into
      build/package, builds it on that package instead, as a game outside the repository is built,
      the bridge for each platform coming with it (build/publish-feature-test.sh).
    -->
    <ItemGroup Condition="'$(BevyCSharpVersion)' != ''">
        <PackageReference Include="BevyCSharp" Version="$(BevyCSharpVersion)"/>
    </ItemGroup>


    <!--
      The destination is spelled out rather than left to LinkBase, which not every build host
      applies the same way. See the same item in BevyCSharp.Tests.
    -->
    <ItemGroup>
        <None Include="assets/**" CopyToOutputDirectory="PreserveNewest"
              Link="assets/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <!--
      The scene packs' manifests, kept at the checkout's root for bcs and the pack script as well,
      beside the program for its Scenes page. The packs themselves are fetched, never copied.
    -->
    <ItemGroup>
        <None Include="../scenes/*.json" CopyToOutputDirectory="PreserveNewest"
              Link="scenes/%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
