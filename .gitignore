# .NET build output
# Unanchored on purpose: every project directory has its own pair.
bin/
obj/

# NuGet
/packages/
*.nupkg
*.snupkg
# A local nuget.config usually carries machine-specific feed paths.
NuGet.config.user

# Tests, coverage and build logs
TestResults/
*.trx
*.coverage
coverage*.xml
coverage*.json
BenchmarkDotNet.Artifacts/
*.binlog
msbuild.log

# Native bridge (Rust)
# build/build-native.sh writes everything here. These are anchored rather than a
# bare `target/` or `artifacts/`, which would also swallow any C# directory that
# happened to carry one of those names - and `artifacts/` in particular is the
# .NET SDK's own output convention.
/build/target/
/build/target-portable/
/build/artifacts/
/build/package/
# A bridge built for one game with --embed, which carries that game's assets.
/build/embedded/
# A render bridge for exported games, built with --game.
/build/game/
# The Slang compiler build/fetch-slang.sh downloads.
/build/tools/

# Compiled Slang, written beside the assets of whatever ran a shader. Every checkout fetches
# slangc on its first build and fills this again, and each entry is keyed by a hash of the
# bridge's own modules, so a copy in git would go stale with every prelude edit. A game that ships
# without a compiler carries its cache in its own build, not in this repository.
.slang-cache/

# What an app launched by `bcs open` writes, so its output can be read after it is gone.
/build/sessions/

# What build/soak.sh reads from a game it plays, and the game's log.
/build/soak/

# The testers' zips build/publish-feature-test.sh makes, and the folders they are made from.
/build/feature-test/

# A bare `cargo build` in native/ bypasses the script and defaults to here.
/native/target/

# Bevy's own stress tests, fetched at the version the bridge builds by build/bevy-stress.sh, which
# fetches them again where they are missing, so Bevy's code is not copied into this repository.
/native/stress/examples/
# Where a bare `cargo` in native/stress builds, where the measuring scripts name native/target.
/native/stress/target/

# Cargo.lock is deliberately NOT ignored. This crate builds a cdylib that ships
# inside the NuGet package, so the exact dependency graph is part of the release
# and has to stay pinned.

*.rs.bk

# IDEs
# JetBrains (Rider)
.idea/
*.DotSettings.user
*.iml
_ReSharper.Caches/
_ReSharper.*/

# Visual Studio
.vs/
*.user
*.suo
*.userprefs

# Visual Studio Code
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Local-only
.ref/

# Per-machine build defaults, set by whoever works on this checkout.
/build/build-native.local

# Dear ImGui's own window layout file. The editor places every window itself and asks
# ImGui not to write one, so a file here is a leftover from a build that did.
imgui.ini

# Bevy's own assets, which build/fetch-bevy-assets.sh downloads for the examples.
BevyCSharp.Examples/bevy-assets/
